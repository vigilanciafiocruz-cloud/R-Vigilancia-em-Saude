# -----------------------------------------------------------------------------
# FUNCCO PARA CHAMAR A API GEMINI
# -----------------------------------------------------------------------------

chamar_gemini <- function(prompt_text, api_key = "AIzaSyDCWkh6ij5OAxkJH1BF19Y3snOujwJeTbY") {
  
  
  # Se nC#o passar chave, tenta pegar da variC!vel de ambiente
  if (is.null(api_key) || api_key == "") {
    api_key <- Sys.getenv("GEMINI_API_KEY")
  }
  
  # Se ainda estiver vazia, usa a chave hardcoded (APENAS PARA TESTES)
  # IMPORTANTE: Em produC'C#o, use variC!vel de ambiente!
  if (api_key == "") {
    api_key <- "AIzaSyDCWkh6ij5OAxkJH1BF19Y3snOujwJeTbY"  # Sua chave aqui
  }
  
  # Verifica se hC! chave disponC-vel
  if (is.null(api_key) || api_key == "") {
    cat("\nAVISO: Configure a chave GEMINI_API_KEY\n")
    return("[Sem chave de API]")
  }
  
  # URL da API (modelo gemini-2.0-flash C) mais estC!vel)
  url <- paste0(
    "https://generativelanguage.googleapis.com/v1beta/models/",
    "gemini-2.5-flash:generateContent?key=",
    api_key
  )
  
  
  # Corpo da requisiC'C#o em formato correto
  body <- list(
    contents = list(
      list(
        role = "user",
        parts = list(
          list(text = prompt_text)
        )
      )
    )
  )
  
  # Converte para JSON
  body_json <- toJSON(body, auto_unbox = TRUE)
  
  # Chamada C  API com proteC'C#o de erro
  response <- tryCatch({
    POST(
      url = url,
      body = body_json,
      encode = "raw",
      add_headers("Content-Type" = "application/json")
    )
  }, error = function(e) {
    cat("\nErro de conexC#o:", e$message, "\n")
    return(NULL)
  })
  
  # Verifica se houve erro na conexC#o
  if (is.null(response)) {
    return("[Erro ao conectar com API]")
  }
  
  status <- status_code(response)
  
  # Sucesso (HTTP 200)
  if (status == 200) {
    parsed <- content(response, as = "parsed", encoding = "UTF-8")
    
    # Extrai o texto da resposta
    if (!is.null(parsed$candidates) && length(parsed$candidates) > 0) {
      texto <- tryCatch({
        parsed$candidates[[1]]$content$parts[[1]]$text
      }, error = function(e) {
        "[Erro ao extrair texto da resposta]"
      })
      return(texto)
    } else {
      return("[Resposta vazia da API]")
    }
  }
  
  # Tratamento de erros especC-ficos
  erro_msg <- tryCatch({
    content(response, as = "parsed")$error$message
  }, error = function(e) {
    "Erro desconhecido"
  })
  
  if (status == 400) {
    return(paste0("[Erro 400 - RequisiC'C#o invC!lida: ", erro_msg, "]"))
  }
  
  if (status == 403) {
    return("[Erro 403 - API key invC!lida ou sem permissC#o para este modelo]")
  }
  
  if (status == 404) {
    return("[Erro 404 - Modelo nC#o encontrado. Verifique o nome do modelo.]")
  }
  
  if (status == 429) {
    return("[Erro 429 - Cota excedida. Aguarde alguns minutos.]")
  }
  
  if (status == 500) {
    return("[Erro 500 - Erro interno do servidor Google]")
  }
  
  return(paste0("[Erro na API: HTTP ", status, " - ", erro_msg, "]"))
}

